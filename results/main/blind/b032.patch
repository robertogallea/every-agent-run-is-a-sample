+    /**
+     * The slugified title, or the title with the lowest free number appended
+     * (`my-first-post-2`, `my-first-post-3`, ...) when that slug is already taken.
+     */
+    private function uniqueSlug(string $title): string
+    {
+        $base = Str::slug($title) ?: 'post';
+        $slug = $base;
+        $suffix = 2;
+
+        while (Post::where('slug', $slug)->exists()) {
+            $slug = $base.'-'.$suffix++;
+        }
+
+        return $slug;
+    }
