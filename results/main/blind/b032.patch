diff --git a/tests/Feature/PostSlugTest.php b/tests/Feature/PostSlugTest.php
new file mode 100644
index 0000000..39be353
--- /dev/null
+++ b/tests/Feature/PostSlugTest.php
@@ -0,0 +1,48 @@
+<?php
+
+use App\Models\Post;
+use App\Models\User;
+
+it('uses the slugified title as the url without a random suffix', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My first post', 'body' => 'Text', 'publish' => true])
+        ->assertRedirect();
+
+    expect(Post::where('title', 'My first post')->value('slug'))->toBe('my-first-post');
+    $this->get('/posts/my-first-post')->assertOk()->assertSee('My first post');
+});
+
+it('gives a post with a taken title the next free readable slug', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My first post', 'body' => 'One', 'publish' => true]);
+    $this->actingAs($user)->post('/posts', ['title' => 'My first post', 'body' => 'Two', 'publish' => true])
+        ->assertRedirect();
+    $this->actingAs($user)->post('/posts', ['title' => 'My first post', 'body' => 'Three', 'publish' => true])
+        ->assertRedirect();
+
+    expect(Post::where('title', 'My first post')->orderBy('id')->pluck('slug')->all())
+        ->toBe(['my-first-post', 'my-first-post-2', 'my-first-post-3']);
+});
+
+it('skips a slug that another post already uses', function () {
+    $user = User::factory()->create();
+    Post::factory()->create(['slug' => 'my-first-post-2', 'title' => 'Something else']);
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My first post', 'body' => 'Text']);
+    $this->actingAs($user)->post('/posts', ['title' => 'My first post', 'body' => 'Text']);
+
+    expect(Post::where('title', 'My first post')->orderBy('id')->pluck('slug')->all())
+        ->toBe(['my-first-post', 'my-first-post-3']);
+});
+
+it('keeps the url of an existing post when its title changes', function () {
+    $post = Post::factory()->create(['title' => 'Old title', 'slug' => 'old-title-abc123']);
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => 'New title', 'body' => 'Body'])
+        ->assertRedirect();
+
+    expect($post->fresh()->slug)->toBe('old-title-abc123');
+});
