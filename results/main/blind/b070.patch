diff --git a/app/Http/Controllers/PostController.php b/app/Http/Controllers/PostController.php
index 9949f03..ac263ae 100644
--- a/app/Http/Controllers/PostController.php
+++ b/app/Http/Controllers/PostController.php
@@ -50,7 +50,7 @@ public function store(Request $request): RedirectResponse
 
         $post = $request->user()->posts()->create([
             'title' => $data['title'],
-            'slug' => Str::slug($data['title']).'-'.Str::lower(Str::random(6)),
+            'slug' => $this->uniqueSlug($data['title']),
             'body' => $data['body'],
             'published_at' => ($data['publish'] ?? false) ? now() : null,
         ]);
@@ -78,4 +78,19 @@ public function update(Request $request, Post $post): RedirectResponse
 
         return redirect()->route('posts.edit', $post);
     }
+
+    /**
+     * Slugify the title, adding -2, -3, ... only when that slug is already taken.
+     */
+    private function uniqueSlug(string $title): string
+    {
+        $base = Str::slug($title) ?: 'post';
+        $slug = $base;
+
+        for ($n = 2; Post::where('slug', $slug)->exists(); $n++) {
+            $slug = $base.'-'.$n;
+        }
+
+        return $slug;
+    }
 }
diff --git a/tests/Feature/PostSlugTest.php b/tests/Feature/PostSlugTest.php
new file mode 100644
index 0000000..c0c8dbc
--- /dev/null
+++ b/tests/Feature/PostSlugTest.php
@@ -0,0 +1,50 @@
+<?php
+
+use App\Models\Post;
+use App\Models\User;
+
+it('uses the slugified title as the URL with no random suffix', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My First Post', 'body' => 'Text', 'publish' => true])
+        ->assertRedirect();
+
+    expect(Post::where('user_id', $user->id)->value('slug'))->toBe('my-first-post');
+});
+
+it('gives a second post with the same title a numbered slug instead of failing', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My first post', 'body' => 'One', 'publish' => true])
+        ->assertRedirect();
+    $this->actingAs($user)->post('/posts', ['title' => 'My first post', 'body' => 'Two', 'publish' => true])
+        ->assertRedirect();
+    $this->actingAs($user)->post('/posts', ['title' => 'My first post', 'body' => 'Three', 'publish' => true])
+        ->assertRedirect();
+
+    expect(Post::orderBy('id')->pluck('slug')->all())
+        ->toBe(['my-first-post', 'my-first-post-2', 'my-first-post-3']);
+});
+
+it('falls back to a readable slug when the title has no letters or digits', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => '!!!', 'body' => 'Text', 'publish' => true])
+        ->assertRedirect();
+
+    expect(Post::where('user_id', $user->id)->value('slug'))->toBe('post');
+});
+
+it('serves a post at its clean URL', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Clean Link', 'body' => 'Text', 'publish' => true]);
+
+    $this->get('/posts/clean-link')->assertOk()->assertSee('Clean Link');
+});
+
+it('keeps existing post URLs unchanged', function () {
+    $post = Post::factory()->create(['title' => 'Old Post', 'slug' => 'old-post-x7k2qa']);
+
+    $this->get('/posts/old-post-x7k2qa')->assertOk()->assertSee('Old Post');
+});
