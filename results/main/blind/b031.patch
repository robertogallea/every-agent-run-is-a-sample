     expect($user->posts()->where('title', 'Mine')->exists())->toBeTrue();
 });
 
+it('creates a post with a clean slug from its title', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My First Post', 'body' => 'Text', 'publish' => true]);
+
+    expect($user->posts()->where('title', 'My First Post')->value('slug'))->toBe('my-first-post');
+});
+
+it('suffixes the slug when the title is already taken', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'Text']);
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'Text']);
+
+    expect(Post::where('title', 'Same Title')->orderBy('id')->pluck('slug')->all())
+        ->toBe(['same-title', 'same-title-2']);
+});
+
 it('requires login to create a post', function () {
