diff --git a/tests/Feature/ScheduledPostTest.php b/tests/Feature/ScheduledPostTest.php
new file mode 100644
index 0000000..a0d02ee
--- /dev/null
+++ b/tests/Feature/ScheduledPostTest.php
@@ -0,0 +1,26 @@
+<?php
+
+use App\Models\Post;
+
+it('hides a scheduled post from the listing until its date', function () {
+    Post::factory()->scheduled()->create(['title' => 'Launch announcement']);
+
+    $this->get('/')
+        ->assertOk()
+        ->assertDontSee('Launch announcement');
+});
+
+it('returns 404 for a scheduled post until its date', function () {
+    $post = Post::factory()->scheduled()->create();
+
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('shows a scheduled post once its date has passed', function () {
+    $post = Post::factory()->scheduled()->create(['title' => 'Launched']);
+
+    $this->travel(2)->days();
+
+    $this->get('/')->assertOk()->assertSee('Launched');
+    $this->get(route('posts.show', $post))->assertOk()->assertSee('Launched');
+});
