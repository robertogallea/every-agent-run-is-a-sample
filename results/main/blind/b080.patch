+++ b/database/migrations/2026_10_30_000000_lowercase_user_emails.php
@@ -0,0 +1,52 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+
+return new class extends Migration
+{
+    /**
+     * Lowercase existing user emails so they match the normalised form
+     * used at login and registration.
+     */
+    public function up(): void
+    {
+        $emails = DB::table('users')->pluck('email');
+
+        $duplicates = $emails
+            ->groupBy(fn (string $email) => Str::lower($email))
+            ->filter(fn ($group) => $group->count() > 1)
+            ->flatten()
+            ->all();
+
+        if ($duplicates !== []) {
+            throw new RuntimeException(
+                'Cannot lowercase user emails: these addresses belong to more than one account when letter case is ignored: '
+                .implode(', ', $duplicates)
+                .'. Resolve the duplicates manually and run the migration again.'
+            );
+        }
+
+        DB::table('users')
+            ->select(['id', 'email'])
+            ->orderBy('id')
+            ->chunkById(500, function ($users) {
+                foreach ($users as $user) {
+                    $lower = Str::lower($user->email);
+
+                    if ($lower !== $user->email) {
+                        DB::table('users')->where('id', $user->id)->update(['email' => $lower]);
+                    }
+                }
+            });
+    }
+
+    /**
+     * The original letter case cannot be restored, so this is a no-op.
+     */
+    public function down(): void
+    {
+        //
+    }
+};
diff --git a/tests/Feature/EmailCaseTest.php b/tests/Feature/EmailCaseTest.php
new file mode 100644
index 0000000..acea7ac
--- /dev/null
+++ b/tests/Feature/EmailCaseTest.php
@@ -0,0 +1,81 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+it('stores the email in lowercase when registering', function () {
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'Ada@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertRedirect(route('posts.index'));
+
+    expect(User::where('email', 'ada@example.com')->exists())->toBeTrue();
+    expect(User::where('email', 'Ada@Example.com')->exists())->toBeFalse();
+});
+
+it('logs in regardless of the letter case used for the email', function () {
+    User::factory()->create(['email' => 'ada@example.com', 'password' => 'secret-password']);
+
+    $this->post('/login', ['email' => 'ADA@example.COM', 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'))
+        ->assertSessionHasNoErrors();
+
+    $this->assertAuthenticated();
+});
+
+it('logs in with a mixed-case email when the account was registered in lowercase', function () {
+    $user = User::factory()->create(['email' => 'ada@example.com', 'password' => 'secret-password']);
+
+    $this->post('/login', ['email' => 'Ada@Example.com', 'password' => 'secret-password'])
+        ->assertSessionHasNoErrors();
+
+    $this->assertAuthenticatedAs($user);
+});
+
+it('rejects a registration whose email differs only by letter case', function () {
+    User::factory()->create(['email' => 'ada@example.com']);
+
+    $this->post('/register', [
+        'name' => 'Ada Two',
+        'email' => 'ADA@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertSessionHasErrors('email');
+
+    $this->assertGuest();
+    expect(User::count())->toBe(1);
+});
+
+it('lowercases emails that were stored in mixed case before the fix', function () {
+    $legacyId = DB::table('users')->insertGetId([
+        'name' => 'Legacy',
+        'email' => 'Grace@Example.com',
+        'password' => bcrypt('secret-password'),
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    $migration = require database_path('migrations/2026_10_30_000000_lowercase_user_emails.php');
+    $migration->up();
+
+    expect(DB::table('users')->where('id', $legacyId)->value('email'))->toBe('grace@example.com');
+
+    $this->post('/login', ['email' => 'GRACE@example.com', 'password' => 'secret-password'])
+        ->assertSessionHasNoErrors();
+
+    $this->assertAuthenticatedAs(User::find($legacyId));
+});
+
+it('refuses to lowercase emails when two accounts would collide', function () {
+    DB::table('users')->insert([
+        ['name' => 'One', 'email' => 'Hedy@Example.com', 'password' => bcrypt('x'), 'created_at' => now(), 'updated_at' => now()],
+        ['name' => 'Two', 'email' => 'hedy@example.com', 'password' => bcrypt('x'), 'created_at' => now(), 'updated_at' => now()],
+    ]);
+
+    $migration = require database_path('migrations/2026_10_30_000000_lowercase_user_emails.php');
+
+    expect(fn () => $migration->up())->toThrow(RuntimeException::class);
+    expect(DB::table('users')->where('email', 'Hedy@Example.com')->exists())->toBeTrue();
+});
