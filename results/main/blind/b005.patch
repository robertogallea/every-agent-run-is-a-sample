+    /**
+     * Use the slugified title, adding "-2", "-3", ... only when that slug is already taken.
+     */
+    private function uniqueSlug(string $title): string
+    {
+        $base = Str::slug($title) ?: 'post';
+        $slug = $base;
+        $suffix = 1;
+
+        while (Post::where('slug', $slug)->exists()) {
+            $slug = $base.'-'.(++$suffix);
+        }
+
+        return $slug;
+    }
