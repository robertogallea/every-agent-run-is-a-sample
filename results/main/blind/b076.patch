     expect($user->posts()->where('title', 'Mine')->exists())->toBeTrue();
 });
 
+it('uses the slugified title as the post slug', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My First Post', 'body' => 'Text', 'publish' => true]);
+
+    expect($user->posts()->where('title', 'My First Post')->value('slug'))->toBe('my-first-post');
+});
+
+it('adds a numeric suffix when the slug is already taken', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'One']);
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'Two']);
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'Three']);
+
+    expect($user->posts()->orderBy('id')->pluck('slug')->all())
+        ->toBe(['same-title', 'same-title-2', 'same-title-3']);
+});
+
+it('falls back to "post" when the title has no slug characters', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => '!!!', 'body' => 'Text']);
+
+    expect($user->posts()->value('slug'))->toBe('post');
+});
+
 it('requires login to create a post', function () {
