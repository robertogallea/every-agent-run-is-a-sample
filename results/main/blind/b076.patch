+    /**
+     * Slugify the title, adding a numeric suffix (-2, -3, ...) only when another post already uses the slug.
+     */
+    private function uniqueSlug(string $title): string
+    {
+        $base = Str::slug($title) ?: 'post';
+        $slug = $base;
+
+        for ($n = 2; Post::where('slug', $slug)->exists(); $n++) {
+            $slug = $base.'-'.$n;
+        }
+
+        return $slug;
+    }
