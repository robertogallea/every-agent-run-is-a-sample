diff --git a/tests/Feature/EmailVerificationTest.php b/tests/Feature/EmailVerificationTest.php
new file mode 100644
index 0000000..f301cbc
--- /dev/null
+++ b/tests/Feature/EmailVerificationTest.php
@@ -0,0 +1,133 @@
+<?php
+
+use App\Models\Post;
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+it('sends a verification email when a user registers', function () {
+    Notification::fake();
+
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'ada@example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ]);
+
+    $user = User::where('email', 'ada@example.com')->firstOrFail();
+
+    expect($user->hasVerifiedEmail())->toBeFalse();
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+it('sends an unverified user to the verification notice when they open the new-post page', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('posts.create'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+it('does not let an unverified user create a post', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post('/posts', ['title' => 'Mine', 'body' => 'Text', 'publish' => true])
+        ->assertRedirect(route('verification.notice'));
+
+    expect($user->posts()->count())->toBe(0);
+});
+
+it('shows the verification notice to an unverified user and lets them resend the email', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee($user->email);
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect();
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+it('does not resend the verification email to a verified user', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('posts.index'));
+
+    Notification::assertNothingSent();
+});
+
+it('marks the user as verified when they follow the signed link', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]);
+
+    $this->actingAs($user)
+        ->get($url)
+        ->assertRedirect(route('posts.index'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+it('rejects a verification link with a wrong hash', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1('someone-else@example.com'),
+    ]);
+
+    $this->actingAs($user)->get($url)->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+it('rejects an unsigned verification link', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', [
+            'id' => $user->getKey(),
+            'hash' => sha1($user->getEmailForVerification()),
+        ]))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+it('lets a verified user create a post', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('posts.create'))
+        ->assertOk();
+
+    $this->actingAs($user)
+        ->post('/posts', ['title' => 'Verified', 'body' => 'Text', 'publish' => true])
+        ->assertRedirect();
+
+    expect(Post::where('title', 'Verified')->exists())->toBeTrue();
+});
+
+it('keeps the browsing pages open to unverified users', function () {
+    $user = User::factory()->unverified()->create();
+    Post::factory()->create(['title' => 'Public post']);
+
+    $this->actingAs($user)
+        ->get('/')
+        ->assertOk()
+        ->assertSee('Public post');
+});
