+it('lets the author publish a draft from the edit page', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body, 'publish' => '1'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->not->toBeNull();
+});
+
+it('lets the author unpublish a post from the edit page', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body, 'publish' => '0'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->toBeNull();
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('keeps the original publish date when saving an already published post', function () {
+    $post = Post::factory()->create(['published_at' => now()->subWeek()]);
+    $original = $post->published_at->toDateTimeString();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => 'Still live', 'body' => $post->body, 'publish' => '1']);
+
+    expect($post->fresh()->published_at->toDateTimeString())->toBe($original);
+});
+
+it('leaves publication state alone when the publish field is absent', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => 'Renamed', 'body' => $post->body])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->not->toBeNull();
+});
+
