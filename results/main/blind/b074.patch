diff --git a/app/Http/Controllers/PostController.php b/app/Http/Controllers/PostController.php
index 9949f03..0c160ce 100644
--- a/app/Http/Controllers/PostController.php
+++ b/app/Http/Controllers/PostController.php
@@ -72,9 +72,20 @@ public function update(Request $request, Post $post): RedirectResponse
         $data = $request->validate([
             'title' => ['required', 'string', 'max:255'],
             'body' => ['required', 'string'],
+            'publish' => ['sometimes', 'boolean'],
         ]);
 
-        $post->update($data);
+        $post->title = $data['title'];
+        $post->body = $data['body'];
+
+        // Only change publication state when the form sends it, so a plain title/body update leaves it alone.
+        if ($request->has('publish')) {
+            $post->published_at = $request->boolean('publish')
+                ? ($post->published_at ?? now())
+                : null;
+        }
+
+        $post->save();
 
         return redirect()->route('posts.edit', $post);
     }
