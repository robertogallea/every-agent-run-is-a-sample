diff --git a/tests/Feature/PostSlugTest.php b/tests/Feature/PostSlugTest.php
new file mode 100644
index 0000000..26d56f5
--- /dev/null
+++ b/tests/Feature/PostSlugTest.php
@@ -0,0 +1,50 @@
+<?php
+
+use App\Models\Post;
+use App\Models\User;
+
+it('uses the slugified title as the new post slug', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My First Post', 'body' => 'Text', 'publish' => true]);
+
+    expect(Post::where('title', 'My First Post')->first()->slug)->toBe('my-first-post');
+});
+
+it('gives a post with a duplicate title a numbered slug instead of failing', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My First Post', 'body' => 'One', 'publish' => true])
+        ->assertRedirect();
+    $this->actingAs($user)->post('/posts', ['title' => 'My First Post', 'body' => 'Two', 'publish' => true])
+        ->assertRedirect();
+    $this->actingAs($user)->post('/posts', ['title' => 'My First Post', 'body' => 'Three', 'publish' => true])
+        ->assertRedirect();
+
+    expect(Post::where('title', 'My First Post')->orderBy('id')->pluck('slug')->all())
+        ->toBe(['my-first-post', 'my-first-post-2', 'my-first-post-3']);
+});
+
+it('serves a new post at its readable URL', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Readable Link', 'body' => 'Text', 'publish' => true]);
+
+    $this->get('/posts/readable-link')->assertOk()->assertSee('Readable Link');
+});
+
+it('falls back to a usable slug when the title has no letters or digits', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => '???', 'body' => 'Text', 'publish' => true])
+        ->assertRedirect();
+
+    expect(Post::where('user_id', $user->id)->value('slug'))->toBe('post');
+});
+
+it('leaves existing post slugs unchanged', function () {
+    $post = Post::factory()->create(['title' => 'Old Post', 'slug' => 'old-post-x7k2qa']);
+
+    $this->get('/posts/old-post-x7k2qa')->assertOk()->assertSee('Old Post');
+    expect($post->fresh()->slug)->toBe('old-post-x7k2qa');
+});
