+    /**
+     * The slugified title, with a counter appended only when another post already has that slug.
+     */
+    private function uniqueSlug(string $title): string
+    {
+        $base = Str::slug($title) ?: 'post';
+        $slug = $base;
+
+        for ($n = 2; Post::where('slug', $slug)->exists(); $n++) {
+            $slug = $base.'-'.$n;
+        }
+
+        return $slug;
+    }
