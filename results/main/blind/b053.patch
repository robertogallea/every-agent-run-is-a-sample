             'title' => ['required', 'string', 'max:255'],
             'body' => ['required', 'string'],
+            'publish' => ['sometimes', 'boolean'],
         ]);
 
-        $post->update($data);
+        $attributes = Arr::only($data, ['title', 'body']);
+
+        // Only touch publication when the form sends the flag, so plain edits leave it alone.
