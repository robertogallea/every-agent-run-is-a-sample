diff --git a/tests/Feature/ScheduledPostTest.php b/tests/Feature/ScheduledPostTest.php
new file mode 100644
index 0000000..8f521c3
--- /dev/null
+++ b/tests/Feature/ScheduledPostTest.php
@@ -0,0 +1,41 @@
+<?php
+
+use App\Models\Post;
+
+it('hides a scheduled post from the list until its date', function () {
+    Post::factory()->create(['title' => 'Launch day', 'published_at' => now()->addDay()]);
+
+    $this->get('/')
+        ->assertOk()
+        ->assertDontSee('Launch day');
+});
+
+it('returns 404 for a scheduled post until its date', function () {
+    $post = Post::factory()->create(['published_at' => now()->addDay()]);
+
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('shows a scheduled post once its date has passed', function () {
+    $post = Post::factory()->create(['title' => 'Launch day', 'published_at' => now()->addDay()]);
+
+    $this->travelTo(now()->addDays(2));
+
+    $this->get('/')->assertOk()->assertSee('Launch day');
+    $this->get(route('posts.show', $post))->assertOk()->assertSee('Launch day');
+});
+
+it('keeps a past-dated post visible', function () {
+    $post = Post::factory()->create(['title' => 'Old news', 'published_at' => now()->subWeek()]);
+
+    $this->get('/')->assertOk()->assertSee('Old news');
+    $this->get(route('posts.show', $post))->assertOk()->assertSee('Old news');
+});
+
+it('still lets the author open a scheduled post for editing', function () {
+    $post = Post::factory()->create(['published_at' => now()->addDay()]);
+
+    $this->actingAs($post->user)
+        ->get(route('posts.edit', $post))
+        ->assertOk();
+});
