     expect($user->posts()->where('title', 'Mine')->exists())->toBeTrue();
 });
 
+it('uses the slugified title as the post slug', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My First Post!', 'body' => 'Text', 'publish' => true]);
+
+    expect($user->posts()->value('slug'))->toBe('my-first-post');
+});
+
+it('adds a numeric suffix when the slug is already taken', function () {
+    Post::factory()->create(['title' => 'Same Title', 'slug' => 'same-title']);
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'Text']);
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'Text']);
+
+    expect($user->posts()->orderBy('id')->pluck('slug')->all())->toBe(['same-title-2', 'same-title-3']);
+});
+
+it('does not use the reserved create slug', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Create', 'body' => 'Text']);
+
+    expect($user->posts()->value('slug'))->toBe('create-2');
+});
+
 it('requires login to create a post', function () {
