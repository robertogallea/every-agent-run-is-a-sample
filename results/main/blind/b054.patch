+    /**
+     * Use the slugified title, adding a numeric suffix only when it is already taken.
+     * "create" is excluded because /posts/create is a static route and would shadow the post.
+     */
+    private function uniqueSlug(string $title): string
+    {
+        $base = Str::slug($title) ?: 'post';
+        $slug = $base;
+        $suffix = 2;
+
+        while ($slug === 'create' || Post::where('slug', $slug)->exists()) {
+            $slug = $base.'-'.$suffix++;
+        }
+
+        return $slug;
+    }
