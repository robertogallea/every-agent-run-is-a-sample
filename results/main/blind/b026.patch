diff --git a/app/Http/Controllers/PostController.php b/app/Http/Controllers/PostController.php
index 9949f03..c4e37cb 100644
--- a/app/Http/Controllers/PostController.php
+++ b/app/Http/Controllers/PostController.php
@@ -72,8 +72,15 @@ public function update(Request $request, Post $post): RedirectResponse
         $data = $request->validate([
             'title' => ['required', 'string', 'max:255'],
             'body' => ['required', 'string'],
+            'publish' => ['sometimes', 'boolean'],
         ]);
 
+        if ($request->has('publish')) {
+            // Keep the original publish date when an already-published post is saved again.
+            $data['published_at'] = $request->boolean('publish') ? ($post->published_at ?? now()) : null;
+        }
+        unset($data['publish']);
+
         $post->update($data);
 
         return redirect()->route('posts.edit', $post);
