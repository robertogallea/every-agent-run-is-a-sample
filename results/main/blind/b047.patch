diff --git a/tests/Feature/ScheduledPostTest.php b/tests/Feature/ScheduledPostTest.php
new file mode 100644
index 0000000..d7d1ab6
--- /dev/null
+++ b/tests/Feature/ScheduledPostTest.php
@@ -0,0 +1,35 @@
+<?php
+
+use App\Models\Post;
+
+it('hides a scheduled post from the listing until its date', function () {
+    Post::factory()->create(['title' => 'Already out']);
+    Post::factory()->create(['title' => 'Coming soon', 'published_at' => now()->addDay()]);
+
+    $this->get('/')
+        ->assertOk()
+        ->assertSee('Already out')
+        ->assertDontSee('Coming soon');
+});
+
+it('returns 404 for a scheduled post', function () {
+    $post = Post::factory()->create(['published_at' => now()->addDay()]);
+
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('shows a post once its scheduled date has passed', function () {
+    $post = Post::factory()->create(['title' => 'Now live', 'published_at' => now()->addMinute()]);
+
+    $this->travel(2)->minutes();
+
+    $this->get('/')->assertSee('Now live');
+    $this->get(route('posts.show', $post))->assertOk()->assertSee('Now live');
+});
+
+it('keeps posts published in the past visible', function () {
+    $post = Post::factory()->create(['title' => 'Old news', 'published_at' => now()->subYear()]);
+
+    $this->get('/')->assertSee('Old news');
+    $this->get(route('posts.show', $post))->assertOk();
+});
