+    private function uniqueSlug(string $title): string
+    {
+        $base = Str::slug($title) ?: 'post';
+        $slug = $base;
+
+        for ($suffix = 2; Post::where('slug', $slug)->exists(); $suffix++) {
+            $slug = $base.'-'.$suffix;
+        }
+
+        return $slug;
+    }
