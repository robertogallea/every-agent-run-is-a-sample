diff --git a/tests/Feature/PostPublishingTest.php b/tests/Feature/PostPublishingTest.php
new file mode 100644
index 0000000..39da6d8
--- /dev/null
+++ b/tests/Feature/PostPublishingTest.php
@@ -0,0 +1,68 @@
+<?php
+
+use App\Models\Post;
+use App\Models\User;
+
+it('shows the published checkbox checked for a published post', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->get(route('posts.edit', $post))
+        ->assertOk()
+        ->assertSee('name="publish" value="1" checked', false);
+});
+
+it('shows the published checkbox unchecked for a draft', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs($post->user)
+        ->get(route('posts.edit', $post))
+        ->assertOk()
+        ->assertDontSee('name="publish" value="1" checked', false);
+});
+
+it('unpublishes a post when the box is unchecked', function () {
+    $post = Post::factory()->create(['title' => 'Going offline']);
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => 'Going offline', 'body' => 'Text'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->toBeNull();
+
+    $this->get('/')->assertDontSee('Going offline');
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('publishes a draft when the box is checked', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->freezeTime();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => 'Text', 'publish' => '1'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->toEqual(now()->startOfSecond());
+});
+
+it('keeps the original publication date when a published post is saved', function () {
+    $publishedAt = now()->subWeek()->startOfSecond();
+    $post = Post::factory()->create(['published_at' => $publishedAt]);
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => 'Edited', 'body' => 'Text', 'publish' => '1'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->toEqual($publishedAt);
+});
+
+it('does not let someone else change the published state', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => 'x'])
+        ->assertForbidden();
+
+    expect($post->fresh()->published_at)->not->toBeNull();
+});
