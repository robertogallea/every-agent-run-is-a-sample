+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+
+return new class extends Migration
+{
+    /**
+     * Store every user's email address in lowercase so that lookups and the
+     * unique index treat addresses that differ only by case as the same.
+     */
+    public function up(): void
+    {
+        $emails = DB::table('users')->orderBy('id')->pluck('email', 'id');
+
+        $clashes = $emails
+            ->groupBy(fn (string $email) => Str::lower($email))
+            ->filter(fn ($group) => $group->count() > 1)
+            ->keys();
+
+        if ($clashes->isNotEmpty()) {
+            throw new RuntimeException(
+                'Cannot lowercase user emails: these addresses clash ignoring case: '.$clashes->implode(', ')
+            );
+        }
+
+        foreach ($emails as $id => $email) {
+            if ($email !== Str::lower($email)) {
+                DB::table('users')->where('id', $id)->update(['email' => Str::lower($email)]);
+            }
+        }
+    }
+
+    /**
+     * The original letter case is not recorded, so it cannot be restored.
+     */
+    public function down(): void
+    {
+        //
+    }
+};
diff --git a/tests/Feature/EmailCaseTest.php b/tests/Feature/EmailCaseTest.php
new file mode 100644
index 0000000..da4d75a
--- /dev/null
+++ b/tests/Feature/EmailCaseTest.php
@@ -0,0 +1,77 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+it('stores the email address in lowercase when registering', function () {
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'Ada@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertRedirect(route('posts.index'));
+
+    expect(User::pluck('email')->all())->toBe(['ada@example.com']);
+});
+
+it('logs in regardless of the letter case used for the email address', function (string $typed) {
+    User::factory()->create(['email' => 'ada@example.com', 'password' => 'secret-password']);
+
+    $this->post('/login', ['email' => $typed, 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticatedAs(User::first());
+})->with(['ada@example.com', 'Ada@Example.com', 'ADA@EXAMPLE.COM']);
+
+it('logs in a user who registered with a mixed-case address before the fix', function (string $typed) {
+    DB::table('users')->insert([
+        'name' => 'Ada',
+        'email' => 'Ada@Example.com',
+        'password' => bcrypt('secret-password'),
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    $migration = require database_path('migrations/2026_10_30_000000_lowercase_user_emails.php');
+    $migration->up();
+
+    $this->post('/login', ['email' => $typed, 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticatedAs(User::first());
+})->with(['ada@example.com', 'Ada@Example.com']);
+
+it('rejects a registration whose email differs from an existing one only by case', function () {
+    User::factory()->create(['email' => 'ada@example.com']);
+
+    $this->post('/register', [
+        'name' => 'Ada Two',
+        'email' => 'ADA@example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertSessionHasErrors('email');
+
+    $this->assertGuest();
+    expect(User::count())->toBe(1);
+});
+
+it('still rejects a wrong password when the email case differs', function () {
+    User::factory()->create(['email' => 'ada@example.com', 'password' => 'secret-password']);
+
+    $this->post('/login', ['email' => 'Ada@Example.com', 'password' => 'wrong-password'])
+        ->assertSessionHasErrors('email');
+
+    $this->assertGuest();
+});
+
+it('refuses to lowercase existing emails when two accounts clash ignoring case', function () {
+    DB::table('users')->insert([
+        ['name' => 'Ada', 'email' => 'ada@example.com', 'password' => 'x', 'created_at' => now(), 'updated_at' => now()],
+        ['name' => 'Ada Two', 'email' => 'Ada@Example.com', 'password' => 'x', 'created_at' => now(), 'updated_at' => now()],
+    ]);
+
+    $migration = require database_path('migrations/2026_10_30_000000_lowercase_user_emails.php');
+
+    expect(fn () => $migration->up())->toThrow(RuntimeException::class, 'ada@example.com');
+    expect(DB::table('users')->orderBy('id')->pluck('email')->all())->toBe(['ada@example.com', 'Ada@Example.com']);
+});
