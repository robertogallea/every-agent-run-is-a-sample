diff --git a/app/Http/Controllers/PostController.php b/app/Http/Controllers/PostController.php
index 9949f03..0db488d 100644
--- a/app/Http/Controllers/PostController.php
+++ b/app/Http/Controllers/PostController.php
@@ -72,9 +72,21 @@ public function update(Request $request, Post $post): RedirectResponse
         $data = $request->validate([
             'title' => ['required', 'string', 'max:255'],
             'body' => ['required', 'string'],
+            'publish' => ['boolean'],
         ]);
 
-        $post->update($data);
+        $publish = $data['publish'] ?? false;
+
+        $post->update([
+            'title' => $data['title'],
+            'body' => $data['body'],
+            // An already published post keeps its original publication date.
+            'published_at' => match (true) {
+                ! $publish => null,
+                $post->published_at !== null => $post->published_at,
+                default => now(),
+            },
+        ]);
 
         return redirect()->route('posts.edit', $post);
     }
