diff --git a/tests/Feature/PostPublishingTest.php b/tests/Feature/PostPublishingTest.php
new file mode 100644
index 0000000..c03e813
--- /dev/null
+++ b/tests/Feature/PostPublishingTest.php
@@ -0,0 +1,109 @@
+<?php
+
+use App\Models\Post;
+use App\Models\User;
+use Illuminate\Support\Carbon;
+
+it('shows the published checkbox ticked for a published post', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->get(route('posts.edit', $post))
+        ->assertSee('name="publish" value="1" checked', false);
+});
+
+it('shows the published checkbox unticked for a draft', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs($post->user)
+        ->get(route('posts.edit', $post))
+        ->assertSee('name="publish" value="1"', false)
+        ->assertDontSee('checked', false);
+});
+
+it('unpublishes a post when the box is unchecked', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->toBeNull();
+    $this->get(route('posts.show', $post))->assertNotFound();
+    $this->get('/')->assertDontSee($post->title);
+});
+
+it('publishes a draft at the current time when the box is checked', function () {
+    $now = Carbon::parse('2026-10-30 12:00:00');
+    $this->travelTo($now);
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body, 'publish' => '1'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->toEqual($now);
+    $this->get(route('posts.show', $post))->assertOk();
+});
+
+it('keeps the original publication date of an already published post', function () {
+    $publishedAt = Carbon::parse('2026-01-15 09:30:00');
+    $post = Post::factory()->create(['published_at' => $publishedAt]);
+
+    $this->travelTo(Carbon::parse('2026-10-30 12:00:00'));
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => 'Edited', 'body' => $post->body, 'publish' => '1'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->toEqual($publishedAt);
+});
+
+it('redisplays the box as the author submitted it after a failed save', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->from(route('posts.edit', $post))
+        ->put(route('posts.update', $post), ['title' => '', 'body' => $post->body, 'publish' => '1'])
+        ->assertSessionHasErrors('title');
+
+    $this->get(route('posts.edit', $post))
+        ->assertSee('name="publish" value="1" checked', false);
+
+    expect($post->fresh()->published_at)->not->toBeNull();
+});
+
+it('leaves the box unticked after a failed save with it unchecked', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->from(route('posts.edit', $post))
+        ->put(route('posts.update', $post), ['title' => '', 'body' => $post->body])
+        ->assertSessionHasErrors('title');
+
+    $this->get(route('posts.edit', $post))
+        ->assertSee('name="publish" value="1"', false)
+        ->assertDontSee('checked', false);
+
+    expect($post->fresh()->published_at)->not->toBeNull();
+});
+
+it('forbids a non-author from unpublishing a post', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body])
+        ->assertForbidden();
+
+    expect($post->fresh()->published_at)->not->toBeNull();
+});
+
+it('forbids a non-author from publishing a draft', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body, 'publish' => '1'])
+        ->assertForbidden();
+
+    expect($post->fresh()->published_at)->toBeNull();
+});
