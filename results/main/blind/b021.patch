@@ -72,9 +72,17 @@ public function update(Request $request, Post $post): RedirectResponse
         $data = $request->validate([
             'title' => ['required', 'string', 'max:255'],
             'body' => ['required', 'string'],
+            'publish' => ['boolean'],
         ]);
 
-        $post->update($data);
+        $attributes = ['title' => $data['title'], 'body' => $data['body']];
+
+        // Only change publication state when the form sends it; keep the original publish time if already published.
+        if (array_key_exists('publish', $data)) {
+            $attributes['published_at'] = $data['publish'] ? ($post->published_at ?? now()) : null;
+        }
+
+        $post->update($attributes);
 
         return redirect()->route('posts.edit', $post);
     }
