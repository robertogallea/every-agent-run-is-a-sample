diff --git a/tests/Feature/EmailVerificationTest.php b/tests/Feature/EmailVerificationTest.php
new file mode 100644
index 0000000..296e6d1
--- /dev/null
+++ b/tests/Feature/EmailVerificationTest.php
@@ -0,0 +1,128 @@
+<?php
+
+use App\Models\Post;
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+it('sends a verification email when a user registers', function () {
+    Notification::fake();
+
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'ada@example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ]);
+
+    $user = User::where('email', 'ada@example.com')->firstOrFail();
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+    expect($user->hasVerifiedEmail())->toBeFalse();
+});
+
+it('sends an unverified user to the verification notice from the new post page', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('posts.create'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+it('does not let an unverified user create a post', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('posts.store'), ['title' => 'Hello', 'body' => 'World', 'publish' => '1'])
+        ->assertRedirect(route('verification.notice'));
+
+    expect(Post::count())->toBe(0);
+});
+
+it('shows the verification notice to an unverified user', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee('Verify your email address');
+});
+
+it('redirects a verified user away from the verification notice', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('verification.notice'))
+        ->assertRedirect(route('posts.index'));
+});
+
+it('lets an unverified user request the verification email again', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertSessionHas('status', 'A new verification link has been sent to your email address.');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+it('marks the user as verified when they follow the signed link', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($user->email),
+    ]);
+
+    $this->actingAs($user)
+        ->get($url)
+        ->assertRedirect(route('posts.index'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+it('rejects a verification link without a valid signature', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->id, 'hash' => sha1($user->email)]))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+it('rejects a signed link that belongs to another user', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $other->id,
+        'hash' => sha1($other->email),
+    ]);
+
+    $this->actingAs($user)->get($url)->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+    expect($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+it('lets a user who has just verified create a post', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($user->email),
+    ]);
+
+    $this->actingAs($user)->get($url);
+
+    $this->actingAs($user->fresh())
+        ->post(route('posts.store'), ['title' => 'Hello', 'body' => 'World'])
+        ->assertRedirect();
+
+    expect(Post::count())->toBe(1);
+});
+
+it('lets guests keep browsing without verifying', function () {
+    $this->get(route('posts.index'))->assertOk();
+});
