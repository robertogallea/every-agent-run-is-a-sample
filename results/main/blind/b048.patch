@@ -0,0 +1,47 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+
+return new class extends Migration
+{
+    /**
+     * Lowercase existing user emails so they match the lowercased emails
+     * that registration and login now store and compare.
+     */
+    public function up(): void
+    {
+        $emails = DB::table('users')->pluck('email');
+
+        $duplicates = $emails
+            ->groupBy(fn (string $email) => Str::lower($email))
+            ->filter(fn ($group) => $group->count() > 1)
+            ->keys();
+
+        if ($duplicates->isNotEmpty()) {
+            throw new RuntimeException(
+                'Cannot lowercase user emails; these addresses belong to more than one account: '
+                .$duplicates->implode(', ')
+            );
+        }
+
+        DB::table('users')->orderBy('id')->chunkById(500, function ($users) {
+            foreach ($users as $user) {
+                $lower = Str::lower($user->email);
+
+                if ($lower !== $user->email) {
+                    DB::table('users')->where('id', $user->id)->update(['email' => $lower]);
+                }
+            }
+        });
+    }
+
+    /**
+     * Emails cannot be restored to their original casing, so this is a no-op.
+     */
+    public function down(): void
+    {
+        //
+    }
+};
diff --git a/tests/Feature/EmailCaseTest.php b/tests/Feature/EmailCaseTest.php
new file mode 100644
index 0000000..aaeb1a9
--- /dev/null
+++ b/tests/Feature/EmailCaseTest.php
@@ -0,0 +1,66 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+it('stores the email in lowercase when registering', function () {
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'Ada@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertRedirect(route('posts.index'));
+
+    expect(User::where('email', 'ada@example.com')->exists())->toBeTrue();
+    expect(User::where('email', 'Ada@Example.com')->exists())->toBeFalse();
+});
+
+it('logs in regardless of the letter case of the email', function (string $registered, string $attempted) {
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => $registered,
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ]);
+    $this->post('/logout');
+
+    $this->post('/login', ['email' => $attempted, 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticatedAs(User::where('email', 'ada@example.com')->firstOrFail());
+})->with([
+    'registered lowercase, logs in mixed case' => ['ada@example.com', 'Ada@Example.com'],
+    'registered mixed case, logs in lowercase' => ['Ada@Example.com', 'ada@example.com'],
+    'registered mixed case, logs in uppercase' => ['Ada@Example.com', 'ADA@EXAMPLE.COM'],
+]);
+
+it('logs in users whose mixed-case email was stored before the fix', function () {
+    DB::table('users')->insert([
+        'name' => 'Legacy',
+        'email' => 'Legacy@Example.com',
+        'password' => bcrypt('secret-password'),
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    (require database_path('migrations/2026_10_30_000000_lowercase_user_emails.php'))->up();
+
+    $this->post('/login', ['email' => 'legacy@example.com', 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticatedAs(User::where('email', 'legacy@example.com')->firstOrFail());
+});
+
+it('rejects a registration whose email differs from an existing one only by case', function () {
+    User::factory()->create(['email' => 'ada@example.com']);
+
+    $this->post('/register', [
+        'name' => 'Other Ada',
+        'email' => 'ADA@example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertSessionHasErrors('email');
+
+    $this->assertGuest();
+    expect(User::count())->toBe(1);
+});
