@@ -0,0 +1,48 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Support\Facades\DB;
+
+return new class extends Migration
+{
+    /**
+     * Lowercase existing email addresses so logins can match them exactly.
+     *
+     * Aborts if two accounts differ only by letter case, because one of them
+     * would have to be removed or merged and that decision belongs to a person.
+     */
+    public function up(): void
+    {
+        $users = DB::table('users')->select(['id', 'email'])->get();
+
+        $idsByNormalisedEmail = [];
+        foreach ($users as $user) {
+            $idsByNormalisedEmail[mb_strtolower($user->email)][] = $user->id;
+        }
+
+        $duplicates = array_filter($idsByNormalisedEmail, fn (array $ids) => count($ids) > 1);
+
+        if ($duplicates !== []) {
+            throw new RuntimeException(
+                'Cannot lowercase user emails: these addresses collide case-insensitively: '
+                .implode(', ', array_keys($duplicates))
+            );
+        }
+
+        foreach ($users as $user) {
+            $normalised = mb_strtolower($user->email);
+
+            if ($normalised !== $user->email) {
+                DB::table('users')->where('id', $user->id)->update(['email' => $normalised]);
+            }
+        }
+    }
+
+    /**
+     * Lowercasing is not reversible, so there is nothing to undo.
+     */
+    public function down(): void
+    {
+        //
+    }
+};
diff --git a/tests/Feature/EmailCaseTest.php b/tests/Feature/EmailCaseTest.php
new file mode 100644
index 0000000..9a5cbfa
--- /dev/null
+++ b/tests/Feature/EmailCaseTest.php
@@ -0,0 +1,100 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Hash;
+
+it('stores the email in lowercase when registering', function () {
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'Ada@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertRedirect(route('posts.index'));
+
+    expect(User::where('email', 'ada@example.com')->exists())->toBeTrue();
+});
+
+it('logs in with an email that differs only in letter case from the registered one', function (string $registered, string $login) {
+    User::factory()->create(['email' => $registered, 'password' => 'secret-password']);
+
+    $this->post('/login', ['email' => $login, 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticated();
+})->with([
+    'registered mixed case, login lowercase' => ['Ada@Example.com', 'ada@example.com'],
+    'registered lowercase, login mixed case' => ['ada@example.com', 'Ada@Example.com'],
+]);
+
+it('logs in with a differently cased email for an account registered through the form', function () {
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'Ada@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ]);
+
+    $this->post('/logout');
+    $this->assertGuest();
+
+    $this->post('/login', ['email' => 'ADA@EXAMPLE.COM', 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticated();
+});
+
+it('still rejects a wrong password when the email case differs', function () {
+    User::factory()->create(['email' => 'ada@example.com', 'password' => 'secret-password']);
+
+    $this->post('/login', ['email' => 'Ada@Example.com', 'password' => 'wrong-password'])
+        ->assertSessionHasErrors('email');
+
+    $this->assertGuest();
+});
+
+it('rejects registering an email that differs from an existing one only by case', function () {
+    User::factory()->create(['email' => 'ada@example.com']);
+
+    $this->post('/register', [
+        'name' => 'Other Ada',
+        'email' => 'Ada@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertSessionHasErrors('email');
+
+    $this->assertGuest();
+    expect(User::count())->toBe(1);
+});
+
+it('lowercases existing mixed-case emails when the normalisation migration runs', function () {
+    $legacy = DB::table('users')->insertGetId([
+        'name' => 'Legacy Ada',
+        'email' => 'Legacy@Example.com',
+        'password' => Hash::make('secret-password'),
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    $migration = require database_path('migrations/2026_10_30_000000_normalize_user_emails_to_lowercase.php');
+    $migration->up();
+
+    expect(DB::table('users')->where('id', $legacy)->value('email'))->toBe('legacy@example.com');
+
+    $this->post('/login', ['email' => 'LEGACY@example.com', 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticatedAs(User::find($legacy));
+});
+
+it('refuses to run the normalisation migration when two accounts differ only by case', function () {
+    DB::table('users')->insert([
+        ['name' => 'One', 'email' => 'dup@example.com', 'password' => Hash::make('x'), 'created_at' => now(), 'updated_at' => now()],
+        ['name' => 'Two', 'email' => 'Dup@Example.com', 'password' => Hash::make('x'), 'created_at' => now(), 'updated_at' => now()],
+    ]);
+
+    $migration = require database_path('migrations/2026_10_30_000000_normalize_user_emails_to_lowercase.php');
+
+    expect(fn () => $migration->up())->toThrow(RuntimeException::class);
+    expect(DB::table('users')->where('email', 'Dup@Example.com')->exists())->toBeTrue();
+});
