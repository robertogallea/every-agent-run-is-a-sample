diff --git a/tests/Feature/EmailVerificationTest.php b/tests/Feature/EmailVerificationTest.php
new file mode 100644
index 0000000..7f79b46
--- /dev/null
+++ b/tests/Feature/EmailVerificationTest.php
@@ -0,0 +1,133 @@
+<?php
+
+use App\Models\Post;
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+it('sends a verification email when someone registers', function () {
+    Notification::fake();
+
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'ada@example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ]);
+
+    $user = User::where('email', 'ada@example.com')->firstOrFail();
+
+    expect($user->hasVerifiedEmail())->toBeFalse();
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+it('redirects an unverified user away from the new post page', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('posts.create'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+it('does not let an unverified user create a post', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post('/posts', ['title' => 'Mine', 'body' => 'Text', 'publish' => true])
+        ->assertRedirect(route('verification.notice'));
+
+    expect(Post::count())->toBe(0);
+});
+
+it('shows the verification notice to an unverified user', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee('Verify your email address');
+});
+
+it('lets an unverified user browse and log in', function () {
+    $user = User::factory()->unverified()->create(['password' => 'secret-password']);
+
+    $this->get('/')->assertOk();
+
+    $this->post('/login', ['email' => $user->email, 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+it('marks the user as verified when the signed link is followed', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]);
+
+    $this->actingAs($user)->get($url)->assertRedirect(route('posts.create'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+it('rejects a verification link with a bad hash', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1('someone-else@example.com'),
+    ]);
+
+    $this->actingAs($user)->get($url)->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+it('rejects a verification link that is not signed', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->getEmailForVerification())]))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+it('lets a verified user create a post after following the link', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]);
+
+    $this->actingAs($user)->get($url);
+
+    $this->actingAs($user->fresh())
+        ->post('/posts', ['title' => 'Mine', 'body' => 'Text', 'publish' => true])
+        ->assertRedirect();
+
+    expect($user->posts()->where('title', 'Mine')->exists())->toBeTrue();
+});
+
+it('resends the verification email to an unverified user', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect()
+        ->assertSessionHas('status');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+it('does not resend the verification email to a verified user', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('posts.index'));
+
+    Notification::assertNothingSent();
+});
