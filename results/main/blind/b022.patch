diff --git a/tests/Feature/PostTest.php b/tests/Feature/PostTest.php
index 30cb0ff..e2aa060 100644
--- a/tests/Feature/PostTest.php
+++ b/tests/Feature/PostTest.php
@@ -55,3 +55,60 @@
         ->put(route('posts.update', $post), ['title' => 'Hijacked', 'body' => 'x'])
         ->assertForbidden();
 });
+
+it('lets the author publish a draft from the edit page', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs($post->user)
+        ->post(route('posts.publish', $post))
+        ->assertRedirect(route('posts.edit', $post));
+
+    expect($post->fresh()->published_at)->not->toBeNull();
+    $this->get(route('posts.show', $post))->assertOk();
+});
+
+it('lets the author unpublish a post from the edit page', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->delete(route('posts.unpublish', $post))
+        ->assertRedirect(route('posts.edit', $post));
+
+    expect($post->fresh()->published_at)->toBeNull();
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('keeps the original publish date when publishing an already published post', function () {
+    $post = Post::factory()->create();
+    $originalPublishedAt = $post->published_at;
+
+    $this->actingAs($post->user)->post(route('posts.publish', $post));
+
+    expect($post->fresh()->published_at->equalTo($originalPublishedAt))->toBeTrue();
+});
+
+it('forbids publishing or unpublishing someone else\'s post', function () {
+    $draft = Post::factory()->draft()->create();
+    $published = Post::factory()->create();
+    $intruder = User::factory()->create();
+
+    $this->actingAs($intruder)->post(route('posts.publish', $draft))->assertForbidden();
+    $this->actingAs($intruder)->delete(route('posts.unpublish', $published))->assertForbidden();
+
+    expect($draft->fresh()->published_at)->toBeNull();
+    expect($published->fresh()->published_at)->not->toBeNull();
+});
+
+it('shows publish or unpublish on the edit page depending on state', function () {
+    $draft = Post::factory()->draft()->create();
+    $published = Post::factory()->create();
+
+    // Publish and unpublish share a URL and differ only by HTTP verb, so assert on the button labels.
+    $this->actingAs($draft->user)->get(route('posts.edit', $draft))
+        ->assertSee('<button>Publish</button>', false)
+        ->assertDontSee('<button>Unpublish</button>', false);
+
+    $this->actingAs($published->user)->get(route('posts.edit', $published))
+        ->assertSee('<button>Unpublish</button>', false)
+        ->assertDontSee('<button>Publish</button>', false);
+});
