diff --git a/tests/Feature/ScheduledPostTest.php b/tests/Feature/ScheduledPostTest.php
new file mode 100644
index 0000000..4c869c9
--- /dev/null
+++ b/tests/Feature/ScheduledPostTest.php
@@ -0,0 +1,41 @@
+<?php
+
+use App\Models\Post;
+
+it('hides a scheduled post from the index until its publication date', function () {
+    Post::factory()->create(['title' => 'Launch announcement', 'published_at' => now()->addDay()]);
+
+    $this->get('/')
+        ->assertOk()
+        ->assertDontSee('Launch announcement');
+});
+
+it('shows a scheduled post on the index once its publication date has passed', function () {
+    $this->travelTo(now()->addDay()->addMinute());
+
+    Post::factory()->create(['title' => 'Launch announcement', 'published_at' => now()->subMinute()]);
+
+    $this->get('/')
+        ->assertOk()
+        ->assertSee('Launch announcement');
+});
+
+it('returns 404 for a scheduled post', function () {
+    $post = Post::factory()->create(['published_at' => now()->addDay()]);
+
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('shows a post whose publication date has passed', function () {
+    $post = Post::factory()->create(['title' => 'Already out', 'published_at' => now()->subDay()]);
+
+    $this->get(route('posts.show', $post))->assertOk()->assertSee('Already out');
+});
+
+it('still lets the author edit a scheduled post', function () {
+    $post = Post::factory()->create(['published_at' => now()->addDay()]);
+
+    $this->actingAs($post->user)
+        ->get(route('posts.edit', $post))
+        ->assertOk();
+});
