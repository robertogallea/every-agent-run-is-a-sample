diff --git a/tests/Feature/EmailVerificationTest.php b/tests/Feature/EmailVerificationTest.php
new file mode 100644
index 0000000..3a65669
--- /dev/null
+++ b/tests/Feature/EmailVerificationTest.php
@@ -0,0 +1,83 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+it('sends a verification email on registration', function () {
+    Notification::fake();
+
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'ada@example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ]);
+
+    Notification::assertSentTo(User::where('email', 'ada@example.com')->first(), VerifyEmail::class);
+});
+
+it('lets unverified users browse and log in', function () {
+    $user = User::factory()->unverified()->create(['password' => 'secret-password']);
+
+    $this->get('/')->assertOk();
+
+    $this->post('/login', ['email' => $user->email, 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+it('blocks unverified users from creating posts', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get('/posts/create')->assertRedirect(route('verification.notice'));
+    $this->actingAs($user)->post('/posts', ['title' => 'Hi', 'body' => 'Body', 'publish' => true])
+        ->assertRedirect(route('verification.notice'));
+
+    expect($user->posts()->count())->toBe(0);
+});
+
+it('allows verified users to create posts', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get('/posts/create')->assertOk();
+    $this->actingAs($user)->post('/posts', ['title' => 'Hi', 'body' => 'Body', 'publish' => true])
+        ->assertRedirect();
+
+    expect($user->posts()->count())->toBe(1);
+});
+
+it('verifies the email with a signed link', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]);
+
+    $this->actingAs($user)->get($url)->assertRedirect(route('posts.index'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+it('rejects an unsigned verification link', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(route('verification.verify', [
+        'id' => $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]))->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+it('resends the verification email', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->post('/email/verification-notification')->assertRedirect();
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
