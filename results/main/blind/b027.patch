diff --git a/tests/Feature/PostTest.php b/tests/Feature/PostTest.php
index 30cb0ff..6d32b7c 100644
--- a/tests/Feature/PostTest.php
+++ b/tests/Feature/PostTest.php
@@ -55,3 +55,34 @@
         ->put(route('posts.update', $post), ['title' => 'Hijacked', 'body' => 'x'])
         ->assertForbidden();
 });
+
+it('hides a post scheduled for the future until its publish time', function () {
+    $post = Post::factory()->create(['title' => 'Big launch', 'published_at' => now()->addDay()]);
+
+    $this->get('/')->assertOk()->assertDontSee('Big launch');
+    $this->get(route('posts.show', $post))->assertNotFound();
+
+    $this->travel(2)->days();
+
+    $this->get('/')->assertOk()->assertSee('Big launch');
+    $this->get(route('posts.show', $post))->assertOk();
+});
+
+it('schedules a post when a publish time is given', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Later', 'body' => 'Text', 'publish_at' => now()->addDay()->toDateTimeString()])
+        ->assertRedirect();
+
+    $post = $user->posts()->where('title', 'Later')->firstOrFail();
+    expect($post->published_at->isFuture())->toBeTrue();
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('keeps a post as a draft when neither publish nor a time is set', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Draft only', 'body' => 'Text'])->assertRedirect();
+
+    expect($user->posts()->where('title', 'Draft only')->firstOrFail()->published_at)->toBeNull();
+});
