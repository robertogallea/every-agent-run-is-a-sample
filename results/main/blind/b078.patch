diff --git a/tests/Feature/PublishToggleTest.php b/tests/Feature/PublishToggleTest.php
new file mode 100644
index 0000000..9e38e23
--- /dev/null
+++ b/tests/Feature/PublishToggleTest.php
@@ -0,0 +1,82 @@
+<?php
+
+use App\Models\Post;
+use App\Models\User;
+
+it('shows the published checkbox checked for a published post', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->get(route('posts.edit', $post))
+        ->assertOk()
+        ->assertSee('name="publish"', false)
+        ->assertSee('checked', false);
+});
+
+it('shows the published checkbox unchecked for a draft', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs($post->user)
+        ->get(route('posts.edit', $post))
+        ->assertOk()
+        ->assertSee('name="publish"', false)
+        ->assertDontSee('checked', false);
+});
+
+it('publishes a draft when the box is checked', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body, 'publish' => '1'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->not->toBeNull();
+    $this->get(route('posts.show', $post))->assertOk();
+});
+
+it('unpublishes a post when the box is unchecked', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->toBeNull();
+    $this->get('/')->assertDontSee($post->title);
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('keeps the original publication date when saving an already published post', function () {
+    $post = Post::factory()->create(['published_at' => now()->subWeek()]);
+    $original = $post->published_at->toDateTimeString();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => 'Renamed', 'body' => $post->body, 'publish' => '1'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at->toDateTimeString())->toBe($original);
+});
+
+it('does not let anyone else publish or unpublish a post', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->put(route('posts.update', $post), ['title' => 'Hijacked', 'body' => 'x', 'publish' => '1'])
+        ->assertForbidden();
+
+    expect($post->fresh()->published_at)->toBeNull();
+});
+
+it('keeps the checkbox state the user submitted when validation fails', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->from(route('posts.edit', $post))
+        ->put(route('posts.update', $post), ['title' => '', 'body' => $post->body])
+        ->assertRedirect(route('posts.edit', $post))
+        ->assertSessionHasErrors('title');
+
+    $this->get(route('posts.edit', $post))
+        ->assertOk()
+        ->assertDontSee('checked', false);
+});
