     expect($post->fresh()->title)->toBe('Updated');
 });
 
+it('lets the author unpublish a post from the edit page', function () {
+    $post = Post::factory()->create();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->toBeNull();
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('lets the author publish a draft from the edit page', function () {
+    $post = Post::factory()->draft()->create();
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => $post->title, 'body' => $post->body, 'publish' => '1'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at)->not->toBeNull();
+    $this->get(route('posts.show', $post))->assertOk();
+});
+
+it('keeps the original publish time when a published post is saved again', function () {
+    $post = Post::factory()->create();
+    $publishedAt = $post->published_at;
+
+    $this->actingAs($post->user)
+        ->put(route('posts.update', $post), ['title' => 'Edited', 'body' => $post->body, 'publish' => '1'])
+        ->assertRedirect();
+
+    expect($post->fresh()->published_at->equalTo($publishedAt))->toBeTrue();
+});
+
+it('renders the publish checkbox on the edit page reflecting the post state', function () {
+    $published = Post::factory()->create();
+    $draft = Post::factory()->draft()->create(['user_id' => $published->user_id]);
+
+    $this->actingAs($published->user)->get(route('posts.edit', $published))
+        ->assertSee('name="publish"', false)
+        ->assertSee('checked', false);
+
+    $this->actingAs($draft->user)->get(route('posts.edit', $draft))
+        ->assertSee('name="publish"', false)
+        ->assertDontSee('checked', false);
+});
+
