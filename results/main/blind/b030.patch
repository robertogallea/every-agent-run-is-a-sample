diff --git a/tests/Feature/EmailCaseTest.php b/tests/Feature/EmailCaseTest.php
new file mode 100644
index 0000000..1361dae
--- /dev/null
+++ b/tests/Feature/EmailCaseTest.php
@@ -0,0 +1,86 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+it('logs in with an email address that differs only in letter case', function () {
+    User::factory()->create([
+        'email' => 'ada@example.com',
+        'password' => 'secret-password',
+    ]);
+
+    $this->post('/login', ['email' => 'Ada@Example.COM', 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'))
+        ->assertSessionHasNoErrors();
+
+    $this->assertAuthenticatedAs(User::where('email', 'ada@example.com')->first());
+});
+
+it('logs in a user who registered with a mixed-case email address', function () {
+    // Simulates a row created before email addresses were normalised.
+    $user = User::factory()->create(['password' => 'secret-password']);
+    DB::table('users')->where('id', $user->id)->update(['email' => 'Ada@Example.com']);
+
+    $this->post('/login', ['email' => 'ada@example.com', 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'))
+        ->assertSessionHasNoErrors();
+
+    $this->assertAuthenticatedAs($user);
+
+    $this->post('/logout');
+    $this->post('/login', ['email' => 'ADA@EXAMPLE.COM', 'password' => 'secret-password'])
+        ->assertSessionHasNoErrors();
+
+    $this->assertAuthenticatedAs($user);
+});
+
+it('still rejects a wrong password when the email differs only in case', function () {
+    User::factory()->create([
+        'email' => 'ada@example.com',
+        'password' => 'secret-password',
+    ]);
+
+    $this->post('/login', ['email' => 'ADA@example.com', 'password' => 'wrong-password'])
+        ->assertSessionHasErrors('email');
+
+    $this->assertGuest();
+});
+
+it('stores new registrations with a lower-cased email address', function () {
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'Ada@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertRedirect(route('posts.index'));
+
+    expect(User::pluck('email')->all())->toBe(['ada@example.com']);
+});
+
+it('refuses to register an email address that differs from an existing one only in case', function () {
+    User::factory()->create(['email' => 'ada@example.com']);
+
+    $this->post('/register', [
+        'name' => 'Ada Two',
+        'email' => 'ADA@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertSessionHasErrors('email');
+
+    expect(User::count())->toBe(1);
+    $this->assertGuest();
+});
+
+it('refuses to register a mixed-case email address that matches a legacy mixed-case row', function () {
+    $existing = User::factory()->create();
+    DB::table('users')->where('id', $existing->id)->update(['email' => 'Ada@Example.com']);
+
+    $this->post('/register', [
+        'name' => 'Ada Two',
+        'email' => 'ada@example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertSessionHasErrors('email');
+
+    expect(User::count())->toBe(1);
+});
