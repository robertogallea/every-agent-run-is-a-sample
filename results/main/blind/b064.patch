diff --git a/tests/Feature/PostTest.php b/tests/Feature/PostTest.php
index 30cb0ff..aa0f1da 100644
--- a/tests/Feature/PostTest.php
+++ b/tests/Feature/PostTest.php
@@ -34,6 +34,38 @@
     expect($user->posts()->where('title', 'Mine')->exists())->toBeTrue();
 });
 
+it('hides a scheduled post until its publish time', function () {
+    $post = Post::factory()->create(['title' => 'Launch day', 'published_at' => now()->addDay()]);
+
+    $this->get('/')->assertDontSee('Launch day');
+    $this->get(route('posts.show', $post))->assertNotFound();
+
+    $this->travelTo(now()->addDays(2));
+
+    $this->get('/')->assertSee('Launch day');
+    $this->get(route('posts.show', $post))->assertOk();
+});
+
+it('schedules a post for a future publish time', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', [
+        'title' => 'Later',
+        'body' => 'Text',
+        'publish_at' => now()->addDay()->format('Y-m-d\TH:i'),
+    ])->assertRedirect();
+
+    expect($user->posts()->where('title', 'Later')->first()->published_at->isFuture())->toBeTrue();
+});
+
+it('saves a post as a draft when neither publish option is set', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Draft', 'body' => 'Text'])->assertRedirect();
+
+    expect($user->posts()->where('title', 'Draft')->first()->published_at)->toBeNull();
+});
+
 it('requires login to create a post', function () {
     $this->get('/posts/create')->assertRedirect(route('login'));
 });
