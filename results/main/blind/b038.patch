+it('creates a clean slug from the title', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'My First Post', 'body' => 'Text', 'publish' => true]);
+
+    expect($user->posts()->where('slug', 'my-first-post')->exists())->toBeTrue();
+});
+
+it('appends a counter when the slug is already taken', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'One', 'publish' => true]);
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'Two', 'publish' => true]);
+    $this->actingAs($user)->post('/posts', ['title' => 'Same Title', 'body' => 'Three', 'publish' => true]);
+
+    expect($user->posts()->pluck('slug')->all())->toEqual(['same-title', 'same-title-2', 'same-title-3']);
+});
+
