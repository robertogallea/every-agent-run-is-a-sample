diff --git a/tests/Feature/ScheduledPostTest.php b/tests/Feature/ScheduledPostTest.php
new file mode 100644
index 0000000..b861c36
--- /dev/null
+++ b/tests/Feature/ScheduledPostTest.php
@@ -0,0 +1,40 @@
+<?php
+
+use App\Models\Post;
+
+it('hides a scheduled post from the list until its publication date', function () {
+    Post::factory()->create(['title' => 'Launch 2.0', 'published_at' => now()->addDay()]);
+
+    $this->get('/')
+        ->assertOk()
+        ->assertDontSee('Launch 2.0');
+});
+
+it('returns 404 for a scheduled post until its publication date', function () {
+    $post = Post::factory()->create(['published_at' => now()->addDay()]);
+
+    $this->get(route('posts.show', $post))->assertNotFound();
+});
+
+it('shows a scheduled post once its publication date has passed', function () {
+    $post = Post::factory()->create(['title' => 'Launch 2.0', 'published_at' => now()->addDay()]);
+
+    $this->travel(2)->days();
+
+    $this->get('/')->assertOk()->assertSee('Launch 2.0');
+    $this->get(route('posts.show', $post))->assertOk()->assertSee('Launch 2.0');
+});
+
+it('keeps posts published in the past visible', function () {
+    $post = Post::factory()->create(['title' => 'Already out', 'published_at' => now()->subWeek()]);
+
+    $this->get('/')->assertOk()->assertSee('Already out');
+    $this->get(route('posts.show', $post))->assertOk()->assertSee('Already out');
+});
+
+it('keeps drafts hidden regardless of schedule', function () {
+    $draft = Post::factory()->draft()->create(['title' => 'Still a draft']);
+
+    $this->get('/')->assertOk()->assertDontSee('Still a draft');
+    $this->get(route('posts.show', $draft))->assertNotFound();
+});
