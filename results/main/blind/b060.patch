diff --git a/app/Http/Controllers/PostController.php b/app/Http/Controllers/PostController.php
index 9949f03..dec66ce 100644
--- a/app/Http/Controllers/PostController.php
+++ b/app/Http/Controllers/PostController.php
@@ -78,4 +78,22 @@ public function update(Request $request, Post $post): RedirectResponse
 
         return redirect()->route('posts.edit', $post);
     }
+
+    public function publish(Post $post): RedirectResponse
+    {
+        Gate::authorize('update', $post);
+
+        $post->update(['published_at' => $post->published_at ?? now()]);
+
+        return redirect()->route('posts.edit', $post);
+    }
+
+    public function unpublish(Post $post): RedirectResponse
+    {
+        Gate::authorize('update', $post);
+
+        $post->update(['published_at' => null]);
+
+        return redirect()->route('posts.edit', $post);
+    }
 }
