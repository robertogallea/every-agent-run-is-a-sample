+<?php
+
+use App\Models\User;
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Support\Facades\DB;
+
+return new class extends Migration
+{
+    /**
+     * Lowercase existing email addresses so they match the normalised form.
+     *
+     * Aborts without changing anything if two accounts differ only by case,
+     * because one of them would then have to be merged or removed by hand.
+     */
+    public function up(): void
+    {
+        $users = DB::table('users')->select(['id', 'email'])->orderBy('id')->get();
+
+        $ownersByEmail = [];
+
+        foreach ($users as $user) {
+            $ownersByEmail[User::normalizeEmail($user->email)][] = $user->id;
+        }
+
+        $duplicates = array_filter($ownersByEmail, fn (array $ids) => count($ids) > 1);
+
+        if ($duplicates !== []) {
+            $details = collect($duplicates)
+                ->map(fn (array $ids, string $email) => $email.' (user ids: '.implode(', ', $ids).')')
+                ->implode('; ');
+
+            throw new RuntimeException('Cannot lowercase user emails because these addresses belong to more than one account: '.$details);
+        }
+
+        foreach ($users as $user) {
+            $email = User::normalizeEmail($user->email);
+
+            if ($email !== $user->email) {
+                DB::table('users')->where('id', $user->id)->update(['email' => $email]);
+            }
+        }
+    }
+
+    /**
+     * Case cannot be restored, so the lowercased addresses are left as they are.
+     */
+    public function down(): void
+    {
+        //
+    }
+};
diff --git a/tests/Feature/EmailCaseTest.php b/tests/Feature/EmailCaseTest.php
new file mode 100644
index 0000000..9b7be82
--- /dev/null
+++ b/tests/Feature/EmailCaseTest.php
@@ -0,0 +1,85 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Hash;
+
+function lowercaseEmailsMigration(): object
+{
+    return require database_path('migrations/2026_10_30_120000_lowercase_user_emails.php');
+}
+
+it('stores registered email addresses in lowercase', function () {
+    $this->post('/register', [
+        'name' => 'Ada',
+        'email' => 'Ada@Example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertRedirect(route('posts.index'));
+
+    $this->assertDatabaseHas('users', ['email' => 'ada@example.com']);
+    $this->assertDatabaseMissing('users', ['email' => 'Ada@Example.com']);
+});
+
+it('logs in regardless of the case used for the email address', function (string $registered, string $typed) {
+    User::factory()->create(['email' => $registered, 'password' => 'secret-password']);
+
+    $this->post('/login', ['email' => $typed, 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticated();
+})->with([
+    'registered mixed case, typed lowercase' => ['Ada@Example.com', 'ada@example.com'],
+    'registered lowercase, typed mixed case' => ['ada@example.com', 'Ada@Example.com'],
+    'registered mixed case, typed uppercase' => ['Ada@Example.com', 'ADA@EXAMPLE.COM'],
+]);
+
+it('rejects a registration whose email differs only by case from an existing account', function () {
+    User::factory()->create(['email' => 'ada@example.com']);
+
+    $this->post('/register', [
+        'name' => 'Ada Two',
+        'email' => 'ADA@example.com',
+        'password' => 'secret-password',
+        'password_confirmation' => 'secret-password',
+    ])->assertSessionHasErrors('email');
+
+    $this->assertGuest();
+    expect(User::count())->toBe(1);
+});
+
+it('lowercases the email address when a user model is saved', function () {
+    $user = User::factory()->create(['email' => 'Grace@Example.com']);
+
+    expect($user->fresh()->email)->toBe('grace@example.com');
+});
+
+it('lets users who registered with mixed case log in with lowercase after the migration runs', function () {
+    DB::table('users')->insert([
+        'name' => 'Legacy',
+        'email' => 'Legacy@Example.com',
+        'password' => Hash::make('secret-password'),
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    lowercaseEmailsMigration()->up();
+
+    $this->post('/login', ['email' => 'legacy@example.com', 'password' => 'secret-password'])
+        ->assertRedirect(route('posts.index'));
+
+    $this->assertAuthenticated();
+});
+
+it('refuses to lowercase existing emails when two accounts would collide', function () {
+    DB::table('users')->insert([
+        ['name' => 'First', 'email' => 'Dup@Example.com', 'password' => 'x', 'created_at' => now(), 'updated_at' => now()],
+        ['name' => 'Second', 'email' => 'dup@example.com', 'password' => 'x', 'created_at' => now(), 'updated_at' => now()],
+    ]);
+
+    expect(fn () => lowercaseEmailsMigration()->up())
+        ->toThrow(RuntimeException::class, 'dup@example.com');
+
+    $this->assertDatabaseHas('users', ['email' => 'Dup@Example.com']);
+    $this->assertDatabaseHas('users', ['email' => 'dup@example.com']);
+});
